  "compilerOptions": { "types": ["node"] },
  "include": [".", "../src", "../../src/app/core/tournament/*.ts", "../../src/app/features/tournaments/data/*.ts", "../worker-configuration.d.ts"],
  "exclude": ["../../src/**/*.spec.ts"]
}
