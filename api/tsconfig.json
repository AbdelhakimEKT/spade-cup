{
  "compilerOptions": {
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "lib": ["es2023"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["@cloudflare/vitest-plugin/types"]
  },
  "include": [
    "src",
    "test",
    "worker-configuration.d.ts",
    "../src/app/core/tournament/*.ts",
    "../src/app/features/tournaments/data/demo-tournament.ts",
    "../src/app/features/tournaments/data/demo-players.ts",
    "../src/app/features/tournaments/data/tournament.ts",
    "../src/testing/real-friendly-war.ts"
  ],
  "exclude": ["../src/**/*.spec.ts", "scripts"]
}
