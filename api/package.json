{
  "name": "spade-cup-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types",
    "seed:demo": "tsx scripts/seed-demo.ts > scripts/seed-demo.sql && wrangler d1 execute spade-cup-db --remote --file scripts/seed-demo.sql",
    "migrate": "wrangler d1 migrations apply spade-cup-db --remote"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.6",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.151.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20261019.1": true
  }
}
