// Serveur de Spade Cup FR (Cloudflare Worker).
// Séparé de Clan Hall : son propre Worker, sa propre base D1.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spade-cup-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-21",
  "observability": { "enabled": true },
  // La bibliothèque qui pilote le navigateur de Cloudflare utilise des modules de Node.
  "compatibility_flags": ["nodejs_compat"],
  // Un vrai navigateur dans le cloud, pour l'image de l'arbre (voir src/bracket-image.ts).
  "browser": { "binding": "BROWSER" },
  // L'arbitre automatique (src/watch.ts) passe toutes les 5 minutes.
  "triggers": { "crons": ["*/5 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "spade-cup-db",
      "database_id": "99936995-82ee-4ee9-8b00-4985013480fc",
      "migrations_dir": "migrations"
    }
  ],
  // Réglages publics (rien de secret ici : ce fichier est sur GitHub).
  // Le secret, lui, s'enregistre à part : npx wrangler secret put COC_API_TOKEN
  "vars": {
    // Clé PUBLIQUE de l'application Discord (portail développeur → General Information).
    "DISCORD_PUBLIC_KEY": "5d4eba9edc4e064ae264537d2a8cf2407ef2c19b3685e04200067cc988d84dc2",
    // Adresse du site, pour les liens dans les messages du bot.
    "SITE_URL": "https://spade-cup.popi-coc.workers.dev",
    // Relais vers l'API du jeu, depuis une IP fixe (voir src/coc.ts).
    "COC_API_BASE": "https://cocproxy.royaleapi.dev/v1"
  }
}
