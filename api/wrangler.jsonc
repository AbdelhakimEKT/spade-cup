// Serveur de Spade Cup FR (Cloudflare Worker).
// Séparé de Clan Hall : son propre Worker, sa propre base D1.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spade-cup-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-21",
  "observability": { "enabled": true },
  // La bibliothèque qui pilote le navigateur de Cloudflare utilise des modules de Node.
  "compatibility_flags": ["nodejs_compat"],
  // Un vrai navigateur dans le cloud, pour l'image de l'arbre (voir src/bracket-image.ts).
  "browser": { "binding": "BROWSER" },
  // Toutes les minutes : arbitre automatique (src/watch.ts) et suivi des FW
  // (src/fw-tracker.ts). Toutes les 5 minutes, une FW relancée aussitôt la
  // précédente finie pouvait passer entre deux passages et être perdue.
  "triggers": { "crons": ["* * * * *"] },
  // Les logos des matchs « Clan vs Clan » (copiés depuis Discord, dont les
  // liens expirent en 24 h) : gardés jusqu'à l'heure du match + 12 h. Gratuit.
  "kv_namespaces": [
    {
      "binding": "LOGOS",
      "id": "43ace499f1454ea28fcbf39f0c21aed2"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "spade-cup-db",
      "database_id": "99936995-82ee-4ee9-8b00-4985013480fc",
      "migrations_dir": "migrations"
    }
  ],
  // Réglages publics (rien de secret ici : ce fichier est sur GitHub).
  // Le secret, lui, s'enregistre à part : npx wrangler secret put COC_API_TOKEN
  "vars": {
    // Clé PUBLIQUE de l'application Discord (portail développeur → General Information).
    "DISCORD_PUBLIC_KEY": "5d4eba9edc4e064ae264537d2a8cf2407ef2c19b3685e04200067cc988d84dc2",
    // Adresse du site, pour les liens dans les messages du bot.
    "SITE_URL": "https://spade-cup.popi-coc.workers.dev",
    // Salons où le bot poste ses annonces (identifiants publics : clic droit sur
    // le salon → Copier l'identifiant, avec le mode développeur de Discord).
    "DISCORD_CHANNEL_RESULTATS": "",
    "DISCORD_CHANNEL_CLASSEMENT": "",
    "DISCORD_CHANNEL_ARBITRES": "",
    // Salon #statistiques-joueurs : le top 10 FW de la semaine, chaque lundi à 10 h.
    "DISCORD_CHANNEL_STATS": "1565007960713855076",
    // Rôles qui gèrent les soirées FW (/fw) et l'arbitrage (/arbitre), en plus
    // des membres qui peuvent « Gérer le serveur » : Admin, puis Modo.
    "FW_MANAGER_ROLES": "1517890929611116696,1517890701399035924",
    // Soirées FW (/fw lancer) : la fiche d'inscription va dans #inscription,
    // l'annonce (avec le ping du rôle) dans #annonce-fw ; #ticket en cas de souci.
    "DISCORD_CHANNEL_INSCRIPTION": "1517854455742074940",
    "DISCORD_CHANNEL_ANNONCE_FW": "1522954557657714738",
    "DISCORD_CHANNEL_TICKETS": "1520071335156519172",
    // #résultats des soirées FW : le top 5 publié par /fw bilan.
    "DISCORD_CHANNEL_FW_RESULTATS": "1517854742833922078",
    "DISCORD_ROLE_FW": "1521260745541550350",
    // Numéro de la première soirée lancée avec le bot (les suivantes : +1).
    "FW_FIRST_NUMBER": "41",
    // Identifiant PUBLIC de l'application (émojis des HDV).
    "DISCORD_APPLICATION_ID": "1563155880034177115",
    // Les deux clans des FW classiques (hors tournoi), suivis pour les stats :
    // team 1 (FW-team1) puis team 2 (FW-team2), comme sur le site.
    "FW_CLANS": "#2CYJPRCG8,#2JVUP2PGC",
    // Relais vers l'API du jeu, depuis une IP fixe (voir src/coc.ts).
    "COC_API_BASE": "https://cocproxy.royaleapi.dev/v1"
  }
}
